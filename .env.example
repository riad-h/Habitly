# ===========================================
# Habitly — Environment Variables
# ===========================================
# 
# HOW TO USE THIS FILE:
# 1. Copy this file and rename the copy to ".env"
#    (On Mac/Linux: cp .env.example .env)
#    (On Windows: copy .env.example .env)
# 2. Fill in your real values below
# 3. NEVER commit the .env file to Git
#
# ===========================================

# ---- FRONTEND VARIABLES ----
# These are used by the React frontend.
# Get these from your Supabase project:
#   → Go to https://supabase.com/dashboard/
#   → Select your project
#   → Go to Settings → API
#   → Copy "Project URL" and "anon/public" key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Backend API URL
# Only needed if backend is deployed separately
# Leave empty or comment out for local development
# VITE_API_URL=http://localhost:5000/api


# ---- BACKEND VARIABLES ----
# These are used ONLY by the Node.js server.
# NEVER put these in frontend code.

# Grok API key for AI habit generation
# Get from: https://console.x.ai/
# (Sign up → Create API key → Copy it here)
GROK_API_KEY=your-grok-api-key-here

# Server port (default: 5000)
PORT=5000
