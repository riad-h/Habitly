# ===========================================
# Habitly — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to Git.
# ===========================================

# ---- Frontend (safe to expose in browser) ----
# These are used by the React frontend to connect to Supabase.
# Get these from your Supabase project settings.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Backend API URL (defaults to /api for same-origin)
# VITE_API_URL=http://localhost:5000/api

# ---- Backend (NEVER expose to browser) ----
# These are used only by the Node.js server.

# Grok API key for AI habit generation
# Get from: https://console.x.ai/
GROK_API_KEY=your-grok-api-key-here

# Server port
PORT=5000
